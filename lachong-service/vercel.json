{
    "version": 2,
    "builds": [
        {
            "src": "api/server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/ping",
            "dest": "/api/ping.js"
        },
        {
            "src": "/api/(.*)",
            "dest": "/api/server.js"
        }
    ]
}